KEFUBAO_ENV=production
KEFUBAO_AUTH_PORT=8787
APP_SECRET=replace_with_long_random_application_secret
WECOM_CORP_ID=replace_with_corpid
WECOM_AGENT_ID=replace_with_agentid
WECOM_CORP_SECRET=replace_with_secret
# 通讯录同步和客户联系 API 使用各自后台生成的 Secret；不配置时回退应用 Secret。
WECOM_CONTACTS_SECRET=replace_with_contacts_secret
WECOM_CUSTOMER_CONTACT_SECRET=replace_with_customer_contact_secret
WECOM_ARCHIVE_SECRET=replace_with_conversation_archive_secret
WECOM_ARCHIVE_SDK_PATH=/opt/kefubao/sdk/wecom/libWeWorkFinanceSdk_C.so
WECOM_ARCHIVE_PRIVATE_KEY_PATH=/opt/kefubao/secrets/wecom_archive_private_key_v2.pem
WECOM_ARCHIVE_PUBLIC_KEY_VERSION=2
WECOM_ARCHIVE_SEED_SEQ=0
WECOM_ARCHIVE_WINDOW_STEP=1000
WECOM_ARCHIVE_PAGE_SIZE=1000
WECOM_ARCHIVE_TIMEOUT_SECONDS=30
WECOM_ARCHIVE_AUTO_SYNC_SECONDS=0.5
WECOM_ARCHIVE_AUTO_SYNC_ERROR_SECONDS=10
DATABASE_URL=mysql+pymysql://kefubao:replace_with_database_password@127.0.0.1:3306/kefubao?charset=utf8mb4
AI_MODEL_BASE_URL=https://api.minimaxi.com/v1
AI_MODEL_API_KEY=replace_with_model_api_key
AI_MODEL_NAME=MiniMax-M2.1
AI_MODEL_TIMEOUT_SECONDS=60
# timer 每分钟只检查一次阈值；仅群聊新增消息达到 20 条才调用后台摘要模型。
KEFUBAO_SUMMARY_BATCH_SIZE=5
KEFUBAO_SUMMARY_MIN_NEW_MESSAGES=20
YUQUE_PERSONAL_TOKEN=
YUQUE_MCP_URL=http://127.0.0.1:8003/mcp
YUQUE_MCP_TIMEOUT_SECONDS=15
YUQUE_PRODUCT_INDEX_REPO=your-team/product-index
YUQUE_PRODUCT_INDEX_DOC=your-index-document
YUQUE_PRODUCT_DOCS_REPO=your-team/manuals
KEFUBAO_REVIEWER_USERIDS=replace_with_reviewer_wecom_userids
# 轻量检索只监听本机，主服务严格超时并在异常时回退 MySQL FULLTEXT。
# 完成 INT8 产物、RSS、P95 和回退演练后再改为 true；未验证时只走 FULLTEXT。
KEFUBAO_LIGHTWEIGHT_SEARCH_ENABLED=false
KEFUBAO_LIGHTWEIGHT_SEARCH_URL=http://127.0.0.1:8791
KEFUBAO_LIGHTWEIGHT_SEARCH_TIMEOUT_SECONDS=0.8
KEFUBAO_LIGHTWEIGHT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KEFUBAO_LIGHTWEIGHT_EMBEDDING_MODEL_PATH=/opt/kefubao/models/bge-small-zh-int8
KEFUBAO_LIGHTWEIGHT_INDEX_PATH=/opt/kefubao/data/skill-index
KEFUBAO_RETRIEVAL_STRATEGY_VERSION=hybrid-small-v1
