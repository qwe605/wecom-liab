[Unit]
Description=KefuBao Yuque MCP knowledge service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kefubao/wecom-miniprogram
EnvironmentFile=/opt/kefubao/secrets/yuque-mcp.env
Environment=FASTMCP_HOST=127.0.0.1
Environment=FASTMCP_PORT=8003
ExecStart=/opt/kefubao/wecom-miniprogram/.venv/bin/python -m backend.integrations.yuque_readonly_server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
